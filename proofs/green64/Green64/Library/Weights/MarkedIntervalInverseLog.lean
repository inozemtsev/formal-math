/-- Original source band and actual group/free-slot counts, with no
postulated small modulus. This holds for every original free state,
including repeated coordinates in its independent harmonic carrier. -/
theorem source_original_B544_actual_free_product_upper434
    {ι G : Type} [Fintype ι] [DecidableEq ι] [Fintype G] [DecidableEq G]
    {cfg : SourceComparisonFixed434} {x L Y Hprime : ℝ}
    (d : SourceComparisonData434 ι G cfg x L Y Hprime)
    (J ell m : ℕ) (hmJ : m ≤ J) (ν : SourceOriginalProbePattern434 G m)
    (a : SourceOriginalVariableBIGState434
      (fun g : G => {p : ℕ // p ∈ d.Tb g})
      (sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν)) :
    (sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν a:ℝ) ≤
      Real.exp (((ell+m:ℕ):ℝ)*cfg.C0*Real.log L*Real.sqrt L) := by
  have hp (g : G) (i : Fin (sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν g)) :
      ((a g i).val:ℝ) ≤ Real.exp (Real.sqrt L) := by
    apply d.hGroup
    rw [d.hG]
    exact Finset.mem_union_right _
      (Finset.mem_biUnion.mpr ⟨g,Finset.mem_univ _,(a g i).property⟩)
  have htnat : (∑ g : G,sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν g) ≤
      (ell+m)*Fintype.card G := by
    calc
      _ ≤ ∑ _g : G,(ell+m) := Finset.sum_le_sum (fun g hg =>
        source_original_probe_free_mark_cap434 J ell m hmJ ν g)
      _ = _ := by simp [Nat.mul_comm]
  have ht : ((∑ g : G,sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν g:ℕ):ℝ) ≤
      ((ell+m:ℕ):ℝ)*cfg.C0*Real.log L := by
    calc
      _ ≤ ((ell+m:ℕ):ℝ)*(Fintype.card G:ℝ) := by exact_mod_cast htnat
      _ ≤ ((ell+m:ℕ):ℝ)*(cfg.C0*Real.log L) :=
        mul_le_mul_of_nonneg_left d.hBigGroups (Nat.cast_nonneg _)
      _ = _ := by ring
  rw [source_original_B543_prime_product_real434]
  unfold sourceOriginalB542FreePrimeProduct434
  calc
    _ ≤ ∏ g : G,(Real.exp (Real.sqrt L))^
        sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν g := by
      apply Finset.prod_le_prod₀
      · intro g hg
        positivity
      · intro g hg
        calc
          _ ≤ ∏ i : Fin (sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν g),
              Real.exp (Real.sqrt L) := by
            apply Finset.prod_le_prod₀
            · intro i hi
              positivity
            · intro i hi
              exact hp g i
          _ = _ := by simp
    _ = Real.exp (((∑ g : G,
        sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν g:ℕ):ℝ)*Real.sqrt L) := by
      rw [Finset.prod_pow_eq_pow_sum,←Real.exp_nat_mul]
    _ ≤ _ := Real.exp_le_exp.mpr
      (mul_le_mul_of_nonneg_right ht (Real.sqrt_nonneg _))

/-- The exact sublinear exponent budget generated by the original upper
prime band and logarithmic group count. The threshold is uniform in all
original tuples; later modules may reuse this budget for auxiliary products. -/
theorem source_original_B544_eventually_sublinear_mark_exponent434
    (C δ : ℝ) (hC : 0 ≤ C) (hδ : 0 < δ) :
    ∀ᶠ L : ℝ in atTop, C*Real.log L*Real.sqrt L ≤ δ*L := by
  have heps : 0 < δ/(C+1) := by positivity
  have hlog := (isLittleO_log_rpow_atTop (r := (1/2:ℝ)) (by norm_num)).bound heps
  filter_upwards [eventually_ge_atTop (1:ℝ),hlog] with L hL hl
  have hL0 : 0 ≤ L := by linarith
  have hlog0 : 0 ≤ Real.log L := Real.log_nonneg hL
  have hl' : Real.log L ≤ (δ/(C+1))*Real.sqrt L := by
    simpa only [Real.norm_eq_abs,abs_of_nonneg hlog0,
      ←Real.sqrt_eq_rpow,abs_of_nonneg (Real.sqrt_nonneg L)] using hl
  calc
    C*Real.log L*Real.sqrt L ≤ (C+1)*Real.sqrt L*Real.log L := by
      nlinarith [mul_nonneg hlog0 (Real.sqrt_nonneg L)]
    _ ≤ (C+1)*Real.sqrt L*((δ/(C+1))*Real.sqrt L) :=
      mul_le_mul_of_nonneg_left hl' (by positivity)
    _ = δ*(Real.sqrt L)^2 := by
      field_simp
    _ = δ*L := by rw [Real.sq_sqrt hL0]

private theorem B544_eventually_mark_product_remainder434
    (C Bsave : ℝ) (hC : 0 ≤ C) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp (C*Real.log L*Real.sqrt L-L/2) ≤ L^(-Bsave) := by
  have hsave := (isLittleO_exp_neg_mul_rpow_atTop
    (a := (1/4:ℝ)) (by norm_num) (-Bsave)).bound (by norm_num : (0:ℝ)<1)
  filter_upwards [eventually_ge_atTop (0:ℝ),hsave,
    source_original_B544_eventually_sublinear_mark_exponent434 C (1/4) hC (by norm_num)]
    with L hL hs hsmall
  have hs' : Real.exp (-(1/4:ℝ)*L) ≤ L^(-Bsave) := by
    simpa only [Real.norm_eq_abs,abs_of_pos (Real.exp_pos _),
      abs_of_nonneg (Real.rpow_nonneg hL _),one_mul] using hs
  exact (Real.exp_le_exp.mpr (by linarith)).trans hs'

private theorem B544_eventually_original_scale434 (CZ : ℝ) :
    ∀ᶠ L : ℝ in atTop, Real.exp (L/2) ≤ Real.exp L*L^(-CZ) := by
  have h := (isLittleO_exp_neg_mul_rpow_atTop
    (a := (1/2:ℝ)) (by norm_num) (-CZ)).bound (by norm_num : (0:ℝ)<1)
  filter_upwards [eventually_ge_atTop (0:ℝ),h] with L hL hs
  have hs' : Real.exp (-(1/2:ℝ)*L) ≤ L^(-CZ) := by
    simpa only [Real.norm_eq_abs,abs_of_pos (Real.exp_pos _),
      abs_of_nonneg (Real.rpow_nonneg hL _),one_mul] using hs
  calc
    Real.exp (L/2) = Real.exp L*Real.exp (-(1/2:ℝ)*L) := by
      rw [←Real.exp_add]
      congr 1
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hs' (Real.exp_pos _).le

/-- Genuine inverse-log sampling remainder for original distinct free
BIG marks at the original exponential physical scale. The source band
p≤exp(sqrt L), #BIG≤C0 log L, and true free count≤ell+m discharge the
modulus budget. Full labelled auxiliary D_C (with repetitions), signed
physical shift 2*k*D_C, original mark masks, and the exact gcd-overlap
main term remain. This estimates the counting law only: arbitrary
sourceCore/cofactor weights are NOT asserted to be smooth or equidistributed. -/
theorem eventually_source_original_B544_marked_joint_interval_inverse_log434
    (cfg : SourceComparisonFixed434) (ell m : ℕ) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop,
    ∀ {ι G : Type} [Fintype ι] [DecidableEq ι] [Fintype G] [DecidableEq G]
    (x Y Hprime : ℝ) (d : SourceComparisonData434 ι G cfg x L Y Hprime)
    (hx : x=Real.exp L)
    (J : ℕ) (hmJ : m ≤ J) (ν : SourceOriginalProbePattern434 G m)
    (hDisj : ∀ g h p,p ∈ d.Tb g → p ∈ d.Tb h → g=h)
    (a b : SourceOriginalVariableBIGState434
      (fun g : G => {p : ℕ // p ∈ d.Tb g})
      (sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν))
    (ha : ∀ g,Function.Injective (fun i => (a g i).val))
    (hb : ∀ g,Function.Injective (fun i => (b g i).val))
    (aux : SourceOriginalProbeAuxIndex434 m ν → ℕ)
    (haux : aux ∈ Fintype.piFinset (sourceOriginalProbeAuxPrimeSets434 m ν d.Tb))
    (A B k : ℤ)
    (hA : 0 ≤ A)
    (hShift : 0 ≤ A+(2*k)*(∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z:ℕ))
    (hLength : d.Z*((∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z:ℕ):ℝ) ≤
      ((B-A:ℤ):ℝ)),
    let Ma := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν a
    let Mb := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν b
    let DC := ∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z
    |(((Ma*Mb:ℕ):ℝ) / ((B-A:ℤ):ℝ))*
        (sourceOriginalB543MarkedJointIntervalCount434 d J ell m hmJ ν
          a b A B (2*k) DC:ℝ) -
      (if (Ma.gcd Mb:ℤ) ∣ (2*k)*(DC:ℤ) then (Ma.gcd Mb:ℝ) else 0)| ≤ L^(-Bsave) := by
  let C : ℝ := 2*((ell+m:ℕ):ℝ)*cfg.C0
  have hC : 0 ≤ C := by
    dsimp [C]
    exact mul_nonneg (by positivity) cfg.hC0
  filter_upwards [B544_eventually_mark_product_remainder434 C Bsave hC,
    B544_eventually_original_scale434 cfg.CZ] with L hrem hscale
  intro ι G instI instDI instG instDG x Y Hprime d hx
    J hmJ ν hDisj a b ha hb aux haux A B k hA hShift hLength
  dsimp only
  let Ma := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν a
  let Mb := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν b
  let DC := ∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z
  have hZ : Real.exp (L/2) ≤ d.Z := by
    apply hscale.trans
    simpa only [hx] using d.hZ
  have hZ0 : 0 ≤ d.Z := (Real.exp_pos _).le.trans hZ
  have hDC : 0 < DC := by
    apply Finset.prod_pos
    intro z hz
    have hzmem := Fintype.mem_piFinset.mp haux z
    cases z with
    | inl z => exact (d.hTbPrime z.val.1 _ hzmem).pos
    | inr z => exact (d.hTbPrime z.val.1 _ hzmem).pos
  have hDC1 : (1:ℝ) ≤ (DC:ℝ) := by exact_mod_cast hDC
  have hH : Real.exp (L/2) ≤ ((B-A:ℤ):ℝ) := by
    exact hZ.trans ((le_mul_of_one_le_right hZ0 hDC1).trans hLength)
  have hHpos : (0:ℝ) < ((B-A:ℤ):ℝ) := (Real.exp_pos _).trans_le hH
  have hAB : A < B := sub_pos.mp (by exact_mod_cast hHpos)
  have hcount := source_original_B543_original_marked_joint_interval_error434
    d J ell m hmJ ν hDisj a b ha hb A B (2*k) DC hAB hA hShift
  have haP := source_original_B544_actual_free_product_upper434 d J ell m hmJ ν a
  have hbP := source_original_B544_actual_free_product_upper434 d J ell m hmJ ν b
  have hprod : ((Ma*Mb:ℕ):ℝ) ≤ Real.exp (C*Real.log L*Real.sqrt L) := by
    calc
      _ = (Ma:ℝ)*(Mb:ℝ) := by push_cast; rfl
      _ ≤ Real.exp (((ell+m:ℕ):ℝ)*cfg.C0*Real.log L*Real.sqrt L)*
          Real.exp (((ell+m:ℕ):ℝ)*cfg.C0*Real.log L*Real.sqrt L) :=
        mul_le_mul haP hbP (Nat.cast_nonneg _) (Real.exp_pos _).le
      _ = _ := by rw [←Real.exp_add]; congr 1; dsimp [C]; ring
  apply hcount.trans
  calc
    ((Ma*Mb:ℕ):ℝ)/((B-A:ℤ):ℝ) ≤
        Real.exp (C*Real.log L*Real.sqrt L)/Real.exp (L/2) :=
      div_le_div₀ (by positivity) hprod (Real.exp_pos _) hH
    _ = Real.exp (C*Real.log L*Real.sqrt L-L/2) := by rw [Real.exp_sub]
    _ ≤ _ := hrem


section OriginalMeasure
variable {ι G : Type} [Fintype ι] [DecidableEq ι] [Fintype G] [DecidableEq G]
variable {cfg : SourceComparisonFixed434} {x L Y Hprime : ℝ}
variable (d : SourceComparisonData434 ι G cfg x L Y Hprime)
  (J ell m : ℕ) (hmJ : m ≤ J) (ν : SourceOriginalProbePattern434 G m)
local notation "X" => SourceOriginalVariableBIGState434
  (fun g : G => {p : ℕ // p ∈ d.Tb g})
  (sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν)

/-- Precisely the original injective free BIG labels, before asking which
physical position they divide. No alternate tuple carrier is substituted. -/
noncomputable def sourceOriginalB544GenuineFreeStates434 : Finset X :=
  Finset.univ.filter (fun a => ∀ g,Function.Injective (fun i => (a g i).val))

noncomputable def sourceOriginalB544OriginalHarmonicMass434 (a : X) : ℝ :=
  sourceOriginalVariableBIGMass434
    (fun g : G => {p : ℕ // p ∈ d.Tb g})
    (sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν)
    (sourceOriginalJointHarmonicMu434
      (fun g : G => {p : ℕ // p ∈ d.Tb g}) (fun _ p => p.val) d.Vbig) a

/-- L1 discrepancy of the actual V-normalized free-BIG counting pair
measure from its exact gcd-weighted harmonic pair measure. The original
injective masks are retained in both measures. This definition contains
no SMALL decorations, q damping, valuation parity, or arithmetic core. -/
noncomputable def sourceOriginalB544MarkedSamplingL1Error434
    (A B kC : ℤ) (DC : ℕ) : ℝ :=
  let K := sourceOriginalB544GenuineFreeStates434 d J ell m hmJ ν
  let mu := sourceOriginalB544OriginalHarmonicMass434 d J ell m hmJ ν
  let P := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν
  let C := sourceOriginalB542FreeCountNormalizer434 d J ell m hmJ ν
  ∑ a ∈ K,∑ b ∈ K,
    |C^2/((B-A:ℤ):ℝ)*
        (sourceOriginalB543MarkedJointIntervalCount434 d J ell m hmJ ν a b A B kC DC:ℝ) -
      mu a*mu b*(if ((P a).gcd (P b):ℤ) ∣ kC*(DC:ℤ)
        then ((P a).gcd (P b):ℝ) else 0)|

private theorem B544_original_harmonic_state_law434
    (hVbig : ∀ g,d.Vbig g=∑ p ∈ d.Tb g,1/(p:ℝ)) :
    (∀ a : X,0 ≤ sourceOriginalB544OriginalHarmonicMass434 d J ell m hmJ ν a) ∧
    (∑ a : X,sourceOriginalB544OriginalHarmonicMass434 d J ell m hmJ ν a)=1 := by
  let BP : G → Type := fun g => {p : ℕ // p ∈ d.Tb g}
  let t := sourceOriginalProbeFreeMarkCount434 J ell m hmJ ν
  let mu := sourceOriginalJointHarmonicMu434 BP (fun _ p => p.val) d.Vbig
  have hEq : ∀ g,d.Vbig g=∑ p : BP g,1/(p.val:ℝ) := by
    intro g
    exact (hVbig g).trans (Finset.sum_coe_sort (d.Tb g)
      (fun p : ℕ => (1:ℝ)/(p:ℝ))).symm
  obtain ⟨hmu,hmass⟩ := source_original_joint_harmonic_normalized434
    BP (fun _ p => p.val) d.Vbig (fun g => cfg.hv.trans_le (d.hVbig g)) hEq
  exact ⟨source_original_variable_BIG_mass_nonneg434 BP t mu hmu,
    source_original_variable_BIG_law_total434 BP t mu hmass⟩

private theorem B544_original_marked_L1_from_pointwise434
    (hVbig : ∀ g,d.Vbig g=∑ p ∈ d.Tb g,1/(p:ℝ))
    (A B kC : ℤ) (DC : ℕ) (eps : ℝ) (heps : 0 ≤ eps)
    (hpoint : ∀ a ∈ sourceOriginalB544GenuineFreeStates434 d J ell m hmJ ν,
      ∀ b ∈ sourceOriginalB544GenuineFreeStates434 d J ell m hmJ ν,
      let Ma := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν a
      let Mb := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν b
      |(((Ma*Mb:ℕ):ℝ)/((B-A:ℤ):ℝ))*
          (sourceOriginalB543MarkedJointIntervalCount434 d J ell m hmJ ν a b A B kC DC:ℝ) -
        (if (Ma.gcd Mb:ℤ) ∣ kC*(DC:ℤ) then (Ma.gcd Mb:ℝ) else 0)| ≤ eps) :
    sourceOriginalB544MarkedSamplingL1Error434 d J ell m hmJ ν A B kC DC ≤ eps := by
  let K := sourceOriginalB544GenuineFreeStates434 d J ell m hmJ ν
  let mu := sourceOriginalB544OriginalHarmonicMass434 d J ell m hmJ ν
  let P := sourceOriginalB543FreePrimeNatProduct434 d J ell m hmJ ν
  let C := sourceOriginalB542FreeCountNormalizer434 d J ell m hmJ ν
  obtain ⟨hmu,hmu1⟩ := B544_original_harmonic_state_law434 d J ell m hmJ ν hVbig
  have hmass : (∑ a ∈ K,mu a) ≤ 1 := by
    apply (Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ K)
      (fun a ha hnot => hmu a)).trans_eq
    exact hmu1
  have hmass0 : 0 ≤ ∑ a ∈ K,mu a := Finset.sum_nonneg (fun a ha => hmu a)
  have hpair : (∑ a ∈ K,∑ b ∈ K,mu a*mu b) ≤ 1 := by
    rw [←Finset.sum_mul_sum]
    nlinarith
  have hdensity (a : X) : mu a*(P a:ℝ)=C := by
    simpa only [mu,P,sourceOriginalB544OriginalHarmonicMass434,
      source_original_B543_prime_product_real434] using
      source_original_B542_true_harmonic_counting_density434 d J ell m hmJ ν a
  have hbound (a : X) (ha : a ∈ K) (b : X) (hb : b ∈ K) :
      |C^2/((B-A:ℤ):ℝ)*
          (sourceOriginalB543MarkedJointIntervalCount434 d J ell m hmJ ν a b A B kC DC:ℝ) -
        mu a*mu b*(if ((P a).gcd (P b):ℤ) ∣ kC*(DC:ℤ)
          then ((P a).gcd (P b):ℝ) else 0)| ≤ mu a*mu b*eps := by
    have hp := hpoint a ha b hb
    have hc : C^2=mu a*mu b*((P a*P b:ℕ):ℝ) := by
      push_cast
      calc
        _ = (mu a*(P a:ℝ))*(mu b*(P b:ℝ)) := by rw [hdensity a,hdensity b]; ring
        _ = _ := by ring
    rw [hc]
    have heq (v t : ℝ) : mu a*mu b*((P a*P b:ℕ):ℝ)/((B-A:ℤ):ℝ)*v-mu a*mu b*t =
        (mu a*mu b)*((((P a*P b:ℕ):ℝ)/((B-A:ℤ):ℝ))*v-t) := by ring
    rw [heq,abs_mul,abs_of_nonneg (mul_nonneg (hmu a) (hmu b))]
    exact mul_le_mul_of_nonneg_left hp (mul_nonneg (hmu a) (hmu b))
  unfold sourceOriginalB544MarkedSamplingL1Error434
  dsimp only
  calc
    _ ≤ ∑ a ∈ K,∑ b ∈ K,mu a*mu b*eps :=
      Finset.sum_le_sum (fun a ha => Finset.sum_le_sum (fun b hb => hbound a ha b hb))
    _ = (∑ a ∈ K,∑ b ∈ K,mu a*mu b)*eps := by simp only [Finset.sum_mul]
    _ ≤ eps := mul_le_of_le_one_left heps hpair
end OriginalMeasure

/-- Source-budgeted L1 comparison of the TRUE V-normalized physical
free-BIG counting law and the gcd-weighted original harmonic law, with
no prime-tuple cardinality loss. The full source arithmetic weight is
not in these measures; its unsmoothed cofactor constraints need a
separate joint estimate. -/
theorem eventually_source_original_B544_marked_sampling_L1_inverse_log434
    (cfg : SourceComparisonFixed434) (ell m : ℕ) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop,
    ∀ {ι G : Type} [Fintype ι] [DecidableEq ι] [Fintype G] [DecidableEq G]
    (x Y Hprime : ℝ) (d : SourceComparisonData434 ι G cfg x L Y Hprime)
    (hx : x=Real.exp L)
    (hVbig : ∀ g,d.Vbig g=∑ p ∈ d.Tb g,1/(p:ℝ))
    (J : ℕ) (hmJ : m ≤ J) (ν : SourceOriginalProbePattern434 G m)
    (hDisj : ∀ g h p,p ∈ d.Tb g → p ∈ d.Tb h → g=h)
    (aux : SourceOriginalProbeAuxIndex434 m ν → ℕ)
    (haux : aux ∈ Fintype.piFinset (sourceOriginalProbeAuxPrimeSets434 m ν d.Tb))
    (A B k : ℤ) (hA : 0 ≤ A)
    (hShift : 0 ≤ A+(2*k)*(∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z:ℕ))
    (hLength : d.Z*((∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z:ℕ):ℝ) ≤
      ((B-A:ℤ):ℝ)),
    sourceOriginalB544MarkedSamplingL1Error434 d J ell m hmJ ν
      A B (2*k) (∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z) ≤ L^(-Bsave) := by
  filter_upwards [eventually_ge_atTop (0:ℝ),
    eventually_source_original_B544_marked_joint_interval_inverse_log434 cfg ell m Bsave]
    with L hL hinterval
  intro ι G instI instDI instG instDG x Y Hprime d hx hVbig
    J hmJ ν hDisj aux haux A B k hA hShift hLength
  apply B544_original_marked_L1_from_pointwise434 d J ell m hmJ ν hVbig
    A B (2*k) (∏ z : SourceOriginalProbeAuxIndex434 m ν,aux z) (L^(-Bsave))
    (Real.rpow_nonneg hL _)
  intro a ha b hb
  exact hinterval x Y Hprime d hx J hmJ ν hDisj a b
    (Finset.mem_filter.mp ha).2 (Finset.mem_filter.mp hb).2
    aux haux A B k hA hShift hLength
end Green64Analytic.CorrelationSquare

